# Sentinel configuration
#
# Docker Compose reads this file automatically. For the local (non-Docker)
# workflow there is intentionally no dotenv loader — export the variables
# in your shell instead: `set -a; source .env; set +a`

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
# DB_PASSWORD is the single password knob — Compose feeds it to both the
# database container and the API. NOTE: Postgres only applies it when the
# data volume is first initialized; changing it later requires
# `docker compose down -v` (destroys data) or an in-database ALTER ROLE.
DB_PASSWORD=password

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API Authentication (leave empty to disable auth)
API_KEY=

# Logging
LOG_LEVEL=INFO
