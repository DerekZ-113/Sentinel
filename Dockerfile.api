FROM python:3.11-slim

WORKDIR /app

# System deps: libgomp1 for xgboost, curl for healthcheck/entrypoint.
# No gcc/libpq-dev — every Python dep ships wheels (psycopg2-binary).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps from the lock (pinned; regenerate per requirements.lock header)
COPY requirements.lock .
RUN pip install --no-cache-dir -r requirements.lock

# Copy application code
COPY api/ api/
COPY ml/__init__.py ml/__init__.py
COPY ml/constants.py ml/constants.py
COPY ml/xgboost_model.json ml/xgboost_model.json
COPY ml/model_config.json ml/model_config.json
COPY fleet_data/ fleet_data/
COPY scripts/ scripts/
COPY setup_database.py .
COPY entrypoint.sh .

RUN chmod +x entrypoint.sh

# Environment defaults (overridden by docker-compose or .env)
ENV DB_HOST=localhost
ENV DB_PORT=5432
ENV DB_NAME=postgres
ENV DB_USER=postgres
ENV DB_PASSWORD=

# Run as a non-root user
RUN useradd --create-home --uid 1000 sentinel \
    && chown -R sentinel:sentinel /app
USER sentinel

EXPOSE 8000

CMD ["./entrypoint.sh"]
