FROM python:3.11-slim

WORKDIR /app

# Install system deps for psycopg2, xgboost, and health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY api/ api/
COPY ml/xgboost_model.json ml/xgboost_model.json
COPY ml/xgboost_config.joblib ml/xgboost_config.joblib
COPY fleet_data/ fleet_data/
COPY scripts/ scripts/
COPY setup_database.py .
COPY entrypoint.sh .

RUN chmod +x entrypoint.sh

# Environment defaults (overridden by docker-compose)
ENV DB_HOST=localhost
ENV DB_PORT=5432
ENV DB_NAME=postgres
ENV DB_USER=postgres
ENV DB_PASSWORD=password

EXPOSE 8000

CMD ["./entrypoint.sh"]
