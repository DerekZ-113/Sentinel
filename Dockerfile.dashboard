# Stage 1: Build
FROM node:20-alpine AS build

WORKDIR /app

COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci

COPY dashboard/ .

# Docker Compose should serve the live API through nginx, not the static demo
# values loaded from dashboard/.env.production.
ENV VITE_DEMO_MODE=false

RUN npm run build

# Stage 2: Serve with nginx (unprivileged: runs as uid 101, not root)
FROM nginxinc/nginx-unprivileged:alpine

# Copy built files
COPY --from=build /app/dist /usr/share/nginx/html

# Nginx config to proxy API calls and handle SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
